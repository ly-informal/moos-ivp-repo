initialize   DEPLOY = false
initialize   RETURN = false

Behavior = BHV_SimpleWaypoint
{
  name      = waypt_to_point
  pwt       = 100
  condition =(RETURN=true) or (ODOMETRY_DIST>=50) 
  condition = DEPLOY = true
  condition = (ODOMETRY_DIST < 50)  
  endflag   = RETURN = true

  speed      = 2.0
  radius     = 8.0
  ptx        = 100
  pty        = -50
Behavior = BHV_SimpleWaypoint
{
  name      = return_home
  pwt       = 90
  condition = RETURN = true
  condition = DEPLOY = true

  speed     = 2.0
  radius    = 8.0
  ptx       = 0
  pty       = 0
}
